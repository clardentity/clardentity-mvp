# Copy to .env.local for local development. Production values live in
# Vercel's project settings, not in a file.

# Where the backend is. The API defaults to ${NEXT_PUBLIC_BACKEND_URL}/api/v1,
# so most setups only need the first line.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google sign-in. Unset hides the button rather than showing a broken one.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Product analytics (PostHog, EU). Unset sends nothing; even when set, events
# go only after the visitor consents in the banner.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Extra origins for the content security policy's connect-src, space-separated
# (e.g. a LAN backend when testing on a phone). Only read by production builds.
# CSP_EXTRA_CONNECT_SRC=
